# CivicFlow Institutional Command Center — Environment Configuration
# ==============================================================================
# WARNING: NEVER commit real credentials or keys to version control.
# Copy this template to .env and provide your local/deployment secrets.
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication Security
JWT_SECRET=your_strong_jwt_signing_secret_here

# Supabase Managed Database Connection
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Required in production for backend administrative persistence and RLS bypass:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Optional Telemetry & Multi-Agent AI
GEMINI_API_KEY=your_gemini_api_key_here
